rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // Schools collection
    match /schools/{schoolId} {
      allow read: if true;
      allow write: if true;

      match /chats/{messageId} {
        allow read: if true;
        allow create, update: if request.resource.data.content is string;
        allow delete: if true;
      }

      match /config/{configDoc} {
        allow read: if true;
        allow write: if true;
      }

      match /users/{userId} {
        allow read: if true;
        allow write: if true;
      }
    }

    // Global users
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Global chats for cross-school communication
    match /chats/{messageId} {
      allow read: if true;
      allow create, update: if request.resource.data.content is string;
      allow delete: if true;
    }

    // Backups tracking
    match /backups/{backupId} {
      allow read: if true;
      allow write: if true;
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
